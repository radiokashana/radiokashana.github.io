{
	"name": "radiokashana",
	"version": "1.0.0",
	"private": true,
	"description": "RadioKashana",
	"author": "Jorge Vargas",
	"keywords": [
		"gatsby"
	],
	"scripts": {
		"develop": "gatsby develop",
		"start": "gatsby develop",
		"build": "gatsby build",
		"serve": "gatsby serve",
		"clean": "gatsby clean",
		"format": "prettier --trailing-comma es5 --no-semi --single-quote --write \"src/**/*.js\"",
		"test": "jest",
		"test:visual": "playwright test",
		"test:visual:ui": "playwright test --ui",
		"test:visual:headed": "playwright test --headed",
		"test:visual:update": "playwright test --update-snapshots",
		"test:visual:external": "playwright test --project=chromium",
		"convert:html-to-jsx": "node scripts/html-to-jsx-converter.js"
	},
	"dependencies": {
		"@mdx-js/mdx": "^3.1.0",
		"@mdx-js/react": "^2.3.0",
		"@tailwindcss/postcss": "4.1.11",
		"decap-cms-app": "^3.6.4",
		"gatsby": "^5.14.5",
		"gatsby-adapter-netlify": "^1.2.0",
		"gatsby-plugin-decap-cms": "^4.0.4",
		"gatsby-plugin-image": "^3.14.0",
		"gatsby-plugin-manifest": "^5.14.0",
		"gatsby-plugin-mdx": "^5.14.1",
		"gatsby-plugin-offline": "^6.14.0",
		"gatsby-plugin-postcss": "6.14.0",
		"gatsby-plugin-react-helmet": "^6.14.0",
		"gatsby-plugin-sharp": "^5.14.0",
		"gatsby-plugin-sitemap": "^6.14.0",
		"gatsby-source-filesystem": "^5.14.0",
		"gatsby-transformer-json": "^5.14.0",
		"gatsby-transformer-sharp": "^5.14.0",
		"postcss": "^8.5.6",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-helmet": "^6.1.0",
		"sass": "^1.89.2",
		"tailwindcss": "4.1.11"
	},
	"devDependencies": {
		"@playwright/test": "1.55.1"
	}
}
