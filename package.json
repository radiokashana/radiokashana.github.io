{
	"name": "radiokashana",
	"version": "1.0.0",
	"private": true,
	"description": "RadioKashana",
	"author": "Jorge Vargas",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"format": "prettier --trailing-comma es5 --no-semi --single-quote --write \"src/**/*.{js,jsx}\"",
		"test": "jest",
		"test:visual": "playwright test",
		"test:visual:ui": "playwright test --ui",
		"test:visual:headed": "playwright test --headed",
		"test:visual:update": "playwright test --update-snapshots",
		"test:visual:external": "playwright test --project=chromium"
	},
	"dependencies": {
		"next": "^14.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"decap-cms-app": "^3.6.4",
		"gray-matter": "^4.0.3",
		"next-mdx-remote": "^4.4.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.12.3",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^3.0.1",
		"feed": "^4.2.2",
		"tailwindcss": "^3.3.0",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.1",
		"autoprefixer": "^10.4.15"
	},
	"devDependencies": {
		"@playwright/test": "1.54.1",
		"prettier": "^3.0.3",
		"eslint": "^8.49.0",
		"eslint-config-next": "^14.0.0"
	}
}
